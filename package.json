    "url": "git+https://github.com/BeastabTech/agent-workflow-kit.git"
  },
  "bugs": "https://github.com/BeastabTech/agent-workflow-kit/issues",
  "keywords": [
    "ai-agents",
    "agents-md",
    "claude-code",
